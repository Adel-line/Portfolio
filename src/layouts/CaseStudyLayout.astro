---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';

interface Props {
  study: CollectionEntry<'case-studies'>;
  prev?: CollectionEntry<'case-studies'>;
  next?: CollectionEntry<'case-studies'>;
}

const { study, prev, next } = Astro.props;
const { title, outcome, client, role, timeframe, tools, tags } = study.data;

const meta = [
  { label: 'Client', value: client },
  { label: 'Role', value: role },
  { label: 'Timeframe', value: timeframe },
  { label: 'Tools', value: tools.join(', ') },
];
---

<BaseLayout title={`${title} — Adelina Sahlean`} description={outcome}>
  <article>
    <header class="border-b border-oat/60 bg-oat-light/60">
      <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
        <ul class="mb-5 flex flex-wrap gap-2" aria-label="Project tags">
          {
            tags.map((tag) => (
              <li>
                <Tag>{tag}</Tag>
              </li>
            ))
          }
        </ul>
        <h1 class="font-display text-4xl font-bold tracking-tight">{title}</h1>
        <p class="mt-4 text-xl text-rust">{outcome}</p>
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4">
          {
            meta.map((item) => (
              <div>
                <dt class="text-xs font-medium text-moss-deep">{item.label}</dt>
                <dd class="mt-1 text-sm">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <div class="case-prose mx-auto max-w-3xl px-5 py-14 sm:px-8">
      <slot />
    </div>
  </article>

  <nav aria-label="More case studies" class="mx-auto max-w-3xl px-5 pb-20 sm:px-8">
    <div class="flex flex-col gap-4 border-t border-oat/60 pt-8 sm:flex-row sm:justify-between">
      {
        prev ? (
          <a href={`/case-studies/${prev.id}/`} class="group max-w-xs">
            <span class="text-xs font-medium text-moss-deep">Previous</span>
            <span class="mt-1 block font-display font-bold transition-colors duration-200 group-hover:text-rust">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/case-studies/${next.id}/`} class="group max-w-xs sm:text-right">
            <span class="text-xs font-medium text-moss-deep">Next</span>
            <span class="mt-1 block font-display font-bold transition-colors duration-200 group-hover:text-rust">
              {next.data.title}
            </span>
          </a>
        )
      }
    </div>
  </nav>
</BaseLayout>

<style is:global>
  /* Prose rhythm for MDX case-study bodies */
  .case-prose h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .case-prose h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    font-weight: 700;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .case-prose p {
    margin-bottom: 1.25rem;
    color: color-mix(in srgb, var(--color-ink) 88%, transparent);
  }
  .case-prose ul,
  .case-prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    display: grid;
    gap: 0.5rem;
    color: color-mix(in srgb, var(--color-ink) 88%, transparent);
  }
  .case-prose ul {
    list-style: disc;
  }
  .case-prose ol {
    list-style: decimal;
  }
  .case-prose li::marker {
    color: var(--color-rust);
  }
  .case-prose a {
    color: var(--color-rust);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .case-prose a:hover {
    color: var(--color-rust-deep);
  }
  .case-prose strong {
    font-weight: 700;
    color: var(--color-ink);
  }
</style>
