---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';

interface Props {
  study: CollectionEntry<'case-studies'>;
  prev?: CollectionEntry<'case-studies'>;
  next?: CollectionEntry<'case-studies'>;
}

const { study, prev, next } = Astro.props;
const { title, outcome, client, role, timeframe, tools, tags } = study.data;

const meta = [
  { label: 'Client', value: client },
  { label: 'Role', value: role },
  { label: 'Timeframe', value: timeframe },
  { label: 'Tools', value: tools.join(', ') },
];
---

<BaseLayout title={`${title} — Adelina Sahlean`} description={outcome}>
  <article>
    <header class="border-b border-border bg-surface-sunken">
      <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
        <ul class="mb-5 flex flex-wrap gap-2" aria-label="Project tags">
          {
            tags.map((tag) => (
              <li>
                <Tag>{tag}</Tag>
              </li>
            ))
          }
        </ul>
        <h1 class="font-display text-4xl font-extrabold tracking-tight text-primary">{title}</h1>
        <p class="mt-4 text-xl text-accent">{outcome}</p>
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4">
          {
            meta.map((item) => (
              <div>
                <dt class="font-mono text-xs font-medium uppercase tracking-wider text-secondary">
                  {item.label}
                </dt>
                <dd class="mt-1 text-sm text-primary">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <div class="case-prose mx-auto max-w-3xl px-5 py-14 sm:px-8">
      <slot />
    </div>
  </article>

  <nav aria-label="More case studies" class="mx-auto max-w-3xl px-5 pb-20 sm:px-8">
    <div class="flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:justify-between">
      {
        prev ? (
          <a href={`/case-studies/${prev.id}/`} class="group max-w-xs">
            <span class="font-mono text-xs font-medium uppercase tracking-wider text-secondary">
              Previous
            </span>
            <span class="mt-1 block font-display font-bold text-primary transition-colors duration-200 group-hover:text-accent">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/case-studies/${next.id}/`} class="group max-w-xs sm:text-right">
            <span class="font-mono text-xs font-medium uppercase tracking-wider text-secondary">
              Next
            </span>
            <span class="mt-1 block font-display font-bold text-primary transition-colors duration-200 group-hover:text-accent">
              {next.data.title}
            </span>
          </a>
        )
      }
    </div>
  </nav>
</BaseLayout>

<style is:global>
  /* Prose rhythm for MDX case-study bodies */
  .case-prose h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .case-prose h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .case-prose p {
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
  }
  .case-prose ul,
  .case-prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    display: grid;
    gap: 0.5rem;
    color: var(--text-secondary);
  }
  .case-prose ul {
    list-style: disc;
  }
  .case-prose ol {
    list-style: decimal;
  }
  .case-prose li::marker {
    color: var(--accent);
  }
  .case-prose a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .case-prose a:hover {
    color: var(--text-primary);
  }
  .case-prose strong {
    font-weight: 600;
    color: var(--text-primary);
  }
  .case-prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--code-bg);
    color: var(--code-text);
    border-radius: 0.375rem;
    padding: 0.125rem 0.375rem;
  }
  .case-prose pre {
    font-family: var(--font-mono);
    background-color: var(--code-bg);
    color: var(--code-text);
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.25rem;
    overflow-x: auto;
  }
  .case-prose pre code {
    background: none;
    padding: 0;
    font-size: var(--text-sm);
  }
</style>
