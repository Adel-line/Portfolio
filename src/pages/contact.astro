---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Adelina Sahlean"
  description="Get in touch about product design roles in Zürich, Basel, or Lausanne."
>
  <section class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_360px] lg:gap-20">
      <div>
        <h1 class="font-display text-4xl font-bold tracking-tight">Let's talk</h1>
        <p class="mt-5 max-w-lg text-lg text-ink/85">
          Hiring for a design role in Switzerland, or want a walkthrough of any
          project here? Send a note — I reply within two working days.
        </p>

        <form id="contact-form" class="mt-10 max-w-lg" novalidate>
          <div class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="mt-2 w-full rounded-card border border-oat bg-white/60 px-4 py-3 text-base transition-colors duration-200 placeholder:text-ink/40 hover:border-moss focus:border-rust"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="mt-2 w-full rounded-card border border-oat bg-white/60 px-4 py-3 text-base transition-colors duration-200 placeholder:text-ink/40 hover:border-moss focus:border-rust"
                placeholder="you@company.ch"
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium">Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="mt-2 w-full resize-y rounded-card border border-oat bg-white/60 px-4 py-3 text-base transition-colors duration-200 placeholder:text-ink/40 hover:border-moss focus:border-rust"
                placeholder="The role, the team, and what you'd like to see more of"></textarea>
            </div>
          </div>

          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="mt-4 hidden text-sm font-medium"
          >
          </p>

          <button
            type="submit"
            class="mt-6 inline-flex items-center justify-center rounded-button bg-rust px-8 py-3 text-sm font-medium text-linen transition-all duration-200 hover:scale-[1.02] hover:bg-rust-deep active:scale-100 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send message
          </button>
        </form>
      </div>

      <aside class="lg:pt-24">
        <div class="rounded-card bg-oat-light p-8">
          <h2 class="font-display text-lg font-bold">Prefer the direct route?</h2>
          <p class="mt-3 text-sm text-ink/75">
            These always work, form or no form:
          </p>
          <ul class="mt-5 space-y-3 text-sm">
            <li>
              <a
                href="mailto:adelina.sahlean@gmail.com"
                class="font-medium text-rust underline-offset-4 transition-colors duration-200 hover:text-rust-deep hover:underline"
              >
                adelina.sahlean@gmail.com
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/in/adelina-sahlean"
                rel="noopener"
                class="font-medium text-rust underline-offset-4 transition-colors duration-200 hover:text-rust-deep hover:underline"
              >
                linkedin.com/in/adelina-sahlean
              </a>
            </li>
          </ul>
          <p class="mt-6 text-sm text-ink/60">
            Based in Copenhagen (CET+0 to Swiss time) — same-day replies most weekdays.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { submitContactForm } from '../lib/contact';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  function showStatus(message: string, kind: 'success' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'text-moss-deep', 'text-rust-deep');
    status.classList.add(kind === 'success' ? 'text-moss-deep' : 'text-rust-deep');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const formData = new FormData(form);

    if (submitButton) submitButton.disabled = true;

    const result = await submitContactForm({
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      message: String(formData.get('message') ?? ''),
    });

    if (submitButton) submitButton.disabled = false;

    if (result.ok) {
      form.reset();
      showStatus("Thanks — your message is on its way. I'll reply within two working days.", 'success');
    } else {
      showStatus(result.error ?? 'Something went wrong. Please email me directly instead.', 'error');
    }
  });
</script>
