---
import SectionHeading from './SectionHeading.astro';

const steps = [
  {
    name: 'Understand',
    text: 'Interviews, support tickets, and analytics before any screens. I want to know where people give up, and why.',
  },
  {
    name: 'Frame',
    text: 'One written problem statement the team agrees on. Half of design is deciding what not to build.',
  },
  {
    name: 'Prototype and test',
    text: 'Rough early, refined late. I test with 5–8 users per round and change course when the evidence says to.',
  },
  {
    name: 'Ship and measure',
    text: 'I stay close to engineering through build, then check the numbers we said would move. If they didn’t, that’s the next brief.',
  },
];
---

<section class="mx-auto max-w-5xl px-5 py-20 sm:px-8">
  <SectionHeading eyebrow="Process">How I work</SectionHeading>
  <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step, i) => (
        <li class="rounded-card border border-border bg-surface p-6">
          <p class="font-mono text-2xl font-semibold text-accent" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </p>
          <h3 class="mt-3 font-display text-lg font-bold text-primary">{step.name}</h3>
          <p class="mt-2 text-sm text-secondary">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>
