---
import Button from './Button.astro';
---

<!-- Pulled up behind the sticky nav pill (the header's flow height) so the
     gradient glow continues under it instead of cutting off below the nav. -->
<section class="relative isolate -mt-14 overflow-hidden">
  <div data-hero-wash class="hero-glow absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-5xl px-5 pb-20 pt-30 sm:px-8 sm:pb-28 sm:pt-38">
    <p data-hero-fade class="mb-4 font-display text-sm font-semibold uppercase tracking-[0.14em] text-secondary">
      Adelina Sahlean · UX designer
    </p>
    <h1 data-hero-fade class="max-w-3xl font-display text-display font-semibold tracking-tight text-primary">
      I design flows people actually finish.
    </h1>
    <p data-hero-fade class="mt-6 max-w-xl text-lg text-secondary">
      Eight years across fintech, health, and B2B products. Based in Copenhagen,
      moving to Switzerland — available for roles in Zürich, Basel, and Lausanne
      from early 2027.
    </p>
    <div data-hero-fade class="mt-9 flex flex-wrap gap-3">
      <Button href="#work">See the work</Button>
      <Button href="#contact" variant="secondary">Get in touch</Button>
    </div>
  </div>
</section>

<style>
  /* Brand-gradient glow, masked so the page background stays visible —
     never a full-bleed gradient fill. */
  .hero-glow {
    background: var(--gradient-brand);
    opacity: 0.22;
    -webkit-mask-image: radial-gradient(70% 90% at 30% 12%, black 0%, transparent 78%);
    mask-image: radial-gradient(70% 90% at 30% 12%, black 0%, transparent 78%);
  }

  :global(html[data-theme='dark']) .hero-glow {
    opacity: 0.3;
  }
</style>

<script>
  import { playHeroEntrance } from '../scripts/hero-entrance';
  playHeroEntrance();
</script>
