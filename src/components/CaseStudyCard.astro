---
import type { CollectionEntry } from 'astro:content';

interface Props {
  study: CollectionEntry<'case-studies'>;
}

const { study } = Astro.props;
const { title, outcome, tags } = study.data;
const href = `/case-studies/${study.id}/`;
---

<article
  class="group relative flex aspect-square flex-col rounded-card border border-border bg-surface p-6 transition-all duration-200 hover:-translate-y-1 hover:border-border-strong sm:p-7"
>
  <p class="font-mono text-xs font-medium uppercase tracking-wider text-secondary">
    {tags.join(' · ')}
  </p>

  <div class="mt-auto">
    <div class="bg-gradient-brand h-11 w-11 rounded-xl" aria-hidden="true"></div>
    <h3 class="mt-5 font-display text-xl font-bold tracking-tight text-primary">
      <a
        href={href}
        class="transition-colors duration-200 after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
      >
        {title}
      </a>
    </h3>
    <p class="mt-2 text-sm text-secondary">{outcome}</p>
  </div>
</article>
