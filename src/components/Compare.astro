---
/**
 * Side-by-side before/after comparison for case studies.
 * Placeholder-aware like ImageFigure — pass beforeSrc/afterSrc later.
 */
interface Props {
  beforeAlt: string;
  afterAlt: string;
  beforeLabel?: string;
  afterLabel?: string;
  beforeSrc?: string;
  afterSrc?: string;
  caption?: string;
}

const {
  beforeAlt,
  afterAlt,
  beforeLabel = 'Before',
  afterLabel = 'After',
  beforeSrc,
  afterSrc,
  caption,
} = Astro.props;

const panes = [
  { label: beforeLabel, alt: beforeAlt, src: beforeSrc },
  { label: afterLabel, alt: afterAlt, src: afterSrc },
];
---

<figure class="my-10">
  <div class="grid gap-4 sm:grid-cols-2">
    {
      panes.map((pane) => (
        <div>
          <p class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-secondary">
            {pane.label}
          </p>
          <div class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-card border border-border bg-surface-sunken">
            {pane.src ? (
              <img src={pane.src} alt={pane.alt} class="h-full w-full object-cover" loading="lazy" />
            ) : (
              <p role="img" aria-label={pane.alt} class="max-w-xs px-5 text-center text-sm text-tertiary">
                [ Image: {pane.alt} ]
              </p>
            )}
          </div>
        </div>
      ))
    }
  </div>
  {caption && <figcaption class="mt-3 font-mono text-xs text-secondary">{caption}</figcaption>}
</figure>
