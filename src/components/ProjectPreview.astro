---
/**
 * Preview thumbnail for a project card. Renders a real screenshot when a
 * `thumb` src is passed; otherwise draws an on-brand abstract mock of the
 * project's UI so cards always show a visual. The mock layout is keyed to
 * `variant` (the case study's `blob` value) so each project reads distinct.
 * Swapping in a real screenshot later is a one-prop change per project.
 */
interface Props {
  variant?: 'blob-1' | 'blob-2' | 'blob-3' | 'blob-4';
  alt: string;
  thumb?: string;
  class?: string;
}

const { variant = 'blob-1', alt, thumb, class: className = '' } = Astro.props;

const bar = 'rounded-full bg-border';
---

<div
  class:list={[
    'relative aspect-[16/10] w-full overflow-hidden bg-surface-sunken',
    className,
  ]}
>
  {
    thumb ? (
      <img src={thumb} alt={alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
    ) : (
      <div role="img" aria-label={alt} class="absolute inset-0">
        {/* Soft brand wash so the panel isn't flat */}
        <div class="bg-gradient-brand absolute inset-0 opacity-[0.14]"></div>

        {/* Floating app window */}
        <div class="absolute inset-x-5 top-5 bottom-0 overflow-hidden rounded-t-xl border border-border border-b-0 bg-bg-elevated shadow-lg">
          <div class="flex items-center gap-1.5 border-b border-border px-3 py-2">
            <span class="h-2 w-2 rounded-full bg-border-strong"></span>
            <span class="h-2 w-2 rounded-full bg-border-strong"></span>
            <span class="h-2 w-2 rounded-full bg-border-strong"></span>
            <span class={`ml-2 h-2 w-20 ${bar}`}></span>
          </div>

          <div class="p-3.5">
            {variant === 'blob-1' && (
              <div class="mx-auto max-w-[54%] space-y-2.5">
                <div class={`h-2.5 w-3/4 ${bar}`} />
                <div class="h-8 rounded-lg border border-border bg-surface-sunken" />
                <div class="h-8 rounded-lg border border-border bg-surface-sunken" />
                <div class="bg-gradient-brand h-8 rounded-lg" />
              </div>
            )}

            {variant === 'blob-2' && (
              <div class="space-y-2">
                <div class={`h-2.5 w-24 ${bar}`} />
                <div class="grid grid-cols-7 gap-1.5">
                  {Array.from({ length: 21 }).map((_, i) => (
                    <div
                      class:list={[
                        'aspect-square rounded',
                        i === 9 || i === 16 ? 'bg-gradient-brand' : 'bg-surface-sunken',
                      ]}
                    />
                  ))}
                </div>
              </div>
            )}

            {variant === 'blob-3' && (
              <div class="flex gap-3">
                <div class="w-1/4 space-y-1.5">
                  <div class={`h-2 w-full ${bar}`} />
                  <div class={`h-2 w-4/5 ${bar}`} />
                  <div class={`h-2 w-full ${bar}`} />
                  <div class={`h-2 w-3/5 ${bar}`} />
                </div>
                <div class="flex flex-1 items-end gap-1.5">
                  <div class="h-6 flex-1 rounded-sm bg-surface-sunken" />
                  <div class="h-10 flex-1 rounded-sm bg-surface-sunken" />
                  <div class="bg-gradient-brand h-14 flex-1 rounded-sm" />
                  <div class="h-8 flex-1 rounded-sm bg-surface-sunken" />
                  <div class="h-12 flex-1 rounded-sm bg-surface-sunken" />
                </div>
              </div>
            )}

            {variant === 'blob-4' && (
              <div class="grid grid-cols-2 gap-2.5">
                <div class="h-14 rounded-lg border border-border bg-surface-sunken" />
                <div class="bg-gradient-brand h-14 rounded-lg opacity-90" />
                <div class="bg-gradient-brand h-14 rounded-lg opacity-90" />
                <div class="h-14 rounded-lg border border-border bg-surface-sunken" />
              </div>
            )}
          </div>
        </div>
      </div>
    )
  }
</div>
