---
interface Props {
  attribution?: string;
}

const { attribution } = Astro.props;
---

<figure class="my-12 border-l-4 border-rust pl-6 sm:pl-8">
  <blockquote class="font-display text-2xl font-medium tracking-tight text-ink">
    <slot />
  </blockquote>
  {attribution && <figcaption class="mt-3 text-sm text-ink/60">— {attribution}</figcaption>}
</figure>
