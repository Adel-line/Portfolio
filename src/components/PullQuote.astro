---
interface Props {
  attribution?: string;
}

const { attribution } = Astro.props;
---

<figure class="my-12 border-l-4 border-accent pl-6 sm:pl-8">
  <blockquote class="font-body text-2xl font-normal italic text-primary">
    <slot />
  </blockquote>
  {
    attribution && (
      <figcaption class="mt-3 font-mono text-sm text-secondary">— {attribution}</figcaption>
    )
  }
</figure>
