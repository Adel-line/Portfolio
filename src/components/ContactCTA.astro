---
import Button from './Button.astro';
---

<section class="mx-auto max-w-5xl px-5 py-20 sm:px-8">
  <div class="rounded-card bg-ink px-6 py-12 text-linen sm:px-12 sm:py-16">
    <h2 class="font-display text-3xl font-bold tracking-tight">
      Hiring in Switzerland?
    </h2>
    <p class="mt-4 max-w-xl text-lg text-linen/80">
      I can walk you through any of these projects in 20 minutes — the decisions,
      the trade-offs, and what I'd do differently. CET-friendly, obviously.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href="/contact/">Start a conversation</Button>
      <a
        href="mailto:adelina.sahlean@gmail.com"
        class="text-sm font-medium text-linen/80 underline-offset-4 transition-colors duration-200 hover:text-linen hover:underline"
      >
        or email me directly
      </a>
    </div>
  </div>
</section>
