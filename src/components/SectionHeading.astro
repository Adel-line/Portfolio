---
interface Props {
  eyebrow?: string;
  id?: string;
}

const { eyebrow, id } = Astro.props;
---

<div class="mb-10">
  {eyebrow && <p class="mb-2 text-sm font-medium text-moss-deep">{eyebrow}</p>}
  <h2 id={id} class="font-display text-3xl font-bold tracking-tight">
    <slot />
  </h2>
</div>
