---
/**
 * Annotated image slot for case studies. Renders a styled placeholder
 * until a real `src` is provided — captions and alt text stay in place
 * so swapping in final imagery is a one-line change per figure.
 */
interface Props {
  alt: string;
  caption?: string;
  src?: string;
  tone?: 'oat' | 'moss' | 'rust';
  aspect?: string;
}

const { alt, caption, src, tone = 'oat', aspect = '16/9' } = Astro.props;

const tones = {
  oat: 'bg-oat/70',
  moss: 'bg-moss/25',
  rust: 'bg-rust/15',
};
---

<figure class="my-10">
  <div
    class:list={['flex items-center justify-center overflow-hidden rounded-card', tones[tone]]}
    style={`aspect-ratio: ${aspect};`}
  >
    {
      src ? (
        <img src={src} alt={alt} class="h-full w-full object-cover" loading="lazy" />
      ) : (
        <p role="img" aria-label={alt} class="max-w-md px-6 text-center text-sm text-ink/50">
          [ Image: {alt} ]
        </p>
      )
    }
  </div>
  {caption && <figcaption class="mt-3 text-sm text-ink/60">{caption}</figcaption>}
</figure>
