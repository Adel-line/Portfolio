---
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="contact" class="scroll-mt-24" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8">
    <SectionHeading eyebrow="Contact" id="contact-heading">Let's talk</SectionHeading>

    <div class="grid gap-12 lg:grid-cols-[1fr_360px] lg:gap-20">
      <div>
        <p class="max-w-lg text-lg text-secondary">
          Hiring for a design role in Switzerland, or want a walkthrough of any
          project here? Send a note — I reply within two working days.
        </p>

        <form id="contact-form" class="mt-10 max-w-lg" novalidate>
          <div class="space-y-6">
            <div>
              <label for="name" class="block font-display text-sm font-semibold text-primary">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="mt-2 w-full rounded-2xl border border-border-strong bg-surface px-4 py-3 text-base text-primary transition-colors duration-200 placeholder:text-tertiary hover:border-accent focus:border-accent"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="block font-display text-sm font-semibold text-primary">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="mt-2 w-full rounded-2xl border border-border-strong bg-surface px-4 py-3 text-base text-primary transition-colors duration-200 placeholder:text-tertiary hover:border-accent focus:border-accent"
                placeholder="you@company.ch"
              />
            </div>
            <div>
              <label for="message" class="block font-display text-sm font-semibold text-primary">Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="mt-2 w-full resize-y rounded-2xl border border-border-strong bg-surface px-4 py-3 text-base text-primary transition-colors duration-200 placeholder:text-tertiary hover:border-accent focus:border-accent"
                placeholder="The role, the team, and what you'd like to see more of"></textarea>
            </div>
          </div>

          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="mt-4 hidden text-sm font-medium"
          >
          </p>

          <Button type="submit" class="mt-6 disabled:cursor-not-allowed disabled:opacity-40 disabled:shadow-none">
            Send message
          </Button>
        </form>
      </div>

      <aside class="lg:pt-2">
        <div class="rounded-card border border-border bg-surface p-8">
          <h3 class="font-display text-lg font-bold text-primary">Prefer the direct route?</h3>
          <p class="mt-3 text-sm text-secondary">
            These always work, form or no form:
          </p>
          <ul class="mt-5 space-y-3 text-sm">
            <li>
              <a
                href="mailto:adelina.sahlean@gmail.com"
                class="font-medium text-accent underline-offset-4 transition-colors duration-200 hover:underline"
              >
                adelina.sahlean@gmail.com
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/in/adelina-sahlean"
                rel="noopener"
                class="font-medium text-accent underline-offset-4 transition-colors duration-200 hover:underline"
              >
                linkedin.com/in/adelina-sahlean
              </a>
            </li>
          </ul>
          <p class="mt-6 text-sm text-secondary">
            Based in Copenhagen (CET+0 to Swiss time) — same-day replies most weekdays.
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  import { submitContactForm } from '../lib/contact';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  function showStatus(message: string, kind: 'success' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'text-secondary', 'text-accent');
    status.classList.add(kind === 'success' ? 'text-secondary' : 'text-accent');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const formData = new FormData(form);

    if (submitButton) submitButton.disabled = true;

    const result = await submitContactForm({
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      message: String(formData.get('message') ?? ''),
    });

    if (submitButton) submitButton.disabled = false;

    if (result.ok) {
      form.reset();
      showStatus("Thanks — your message is on its way. I'll reply within two working days.", 'success');
    } else {
      showStatus(result.error ?? 'Something went wrong. Please email me directly instead.', 'error');
    }
  });
</script>
