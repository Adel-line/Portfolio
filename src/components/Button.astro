---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
}

const { href, type = 'button', variant = 'primary', class: className } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-button px-6 py-3 text-sm font-medium transition-all duration-200';

const variants = {
  primary: 'bg-rust text-linen hover:bg-rust-deep hover:scale-[1.02] active:scale-100',
  secondary: 'bg-moss text-linen hover:bg-moss-deep hover:scale-[1.02] active:scale-100',
  ghost: 'text-rust border border-rust/40 hover:border-rust hover:bg-rust/5',
};

const classes = [base, variants[variant], className];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes}>
      <slot />
    </button>
  )
}
