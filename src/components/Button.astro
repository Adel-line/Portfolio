---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'ghost';
  disabled?: boolean;
  class?: string;
}

const { href, type = 'button', variant = 'primary', disabled = false, class: className } = Astro.props;

const base =
  'group/btn inline-flex items-center justify-center gap-2 rounded-button font-display text-sm font-semibold transition-all duration-200';

const variants = {
  primary:
    'bg-gradient-brand shadow-accent-soft px-6 py-3 text-white hover:-translate-y-px active:translate-y-0',
  secondary:
    'border-[1.5px] border-border-strong bg-transparent px-6 py-3 text-primary hover:border-accent',
  ghost: 'gap-1.5 text-accent',
};

const disabledClasses = disabled
  ? 'cursor-not-allowed opacity-40 shadow-none hover:translate-y-0 hover:border-border-strong'
  : '';

const classes = [base, variants[variant], disabledClasses, className];
---

{
  href ? (
    <a
      href={disabled ? undefined : href}
      aria-disabled={disabled || undefined}
      class:list={classes}
    >
      <slot />
      {variant === 'ghost' && (
        <span
          class="transition-transform duration-200 group-hover/btn:translate-x-1"
          aria-hidden="true"
        >
          →
        </span>
      )}
    </a>
  ) : (
    <button type={type} disabled={disabled} class:list={classes}>
      <slot />
      {variant === 'ghost' && (
        <span
          class="transition-transform duration-200 group-hover/btn:translate-x-1"
          aria-hidden="true"
        >
          →
        </span>
      )}
    </button>
  )
}
